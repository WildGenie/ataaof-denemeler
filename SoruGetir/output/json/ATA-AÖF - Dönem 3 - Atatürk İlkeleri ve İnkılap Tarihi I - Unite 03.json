    "B": "Tanzimat Fermanı",
    "C": "Nizam-ı Cedit",
    "D": "I. Meşrutiyet",
    "E": "Islahat Fermanı",
    "DogruCevap": "B",
    "DersAd": "Atatürk İlkeleri ve İnkılap Tarihi I",
    "Somestre": 0,
    "DogruCevapSirasi": 2,

        "C": "<span id=\"page123R_mcid629\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\"> Henry Talbot</span></span>",
        "D": "<span id=\"page123R_mcid655\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\"> Louis Ducos du Hauron</span></span>",
        "E": "<span id=\"page123R_mcid616\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Joseph Niepce</span></span>",
        "DogruCevap": "A",

        "DersId": 0,
        "OBSDersId": 0,
        "CevapSira": null,
        "Aciklama": "<span id=\"page92R_mcid205\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Baskı tekniklerinin tarihi, belirli bir görüntüyü </span></span><span id=\"page92R_mcid206\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">yeniden üretmek için kullanılan mühür ve damga</span></span><span id=\"page92R_mcid208\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">lara kadar uzanmaktadır. Fakat matbaacılık tarihin</span></span><span id=\"page92R_mcid210\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">deki en önemli dönüm noktalarından biri, 1450’de </span></span><span id=\"page92R_mcid211\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Johannes Gutenberg tarafından Almanya’da mü</span></span><span id=\"page92R_mcid213\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">kemmelleştirilen tipo baskı tekniğidir. </span></span>"
    },
    {

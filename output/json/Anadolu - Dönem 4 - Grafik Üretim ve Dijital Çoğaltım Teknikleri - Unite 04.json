    {
        "SoruID": 3764600,
        "SoruMetni": "<p><span id=\"page137R_mcid750\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Ofset baskı sistemleri çeşitli temel bi</span></span><span id=\"page137R_mcid752\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">leşenlerden biri <span style=\"text-decoration: underline;\"><strong>değildir?</strong></span> </span></span></p> <p><span id=\"page137R_mcid753\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">I.</span> <span dir=\"ltr\" role=\"presentation\">Mürekkepleme</span> <span dir=\"ltr\" role=\"presentation\">ünitesi,</span></span><span id=\"page137R_mcid754\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">II.</span> <span dir=\"ltr\" role=\"presentation\">Nemlendirme</span> <span dir=\"ltr\" role=\"presentation\">ünitesi,</span></span><span id=\"page137R_mcid755\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">III. </span><span dir=\"ltr\" role=\"presentation\">Kalıp</span> <span dir=\"ltr\" role=\"presentation\">silindiri,</span></span><span id=\"page137R_mcid756\" class=\"markedContent\"><br role=\"presentation\" />IV. <span dir=\"ltr\" role=\"presentation\">Blanket</span> <span dir=\"ltr\" role=\"presentation\">(Kauçuk)</span> <span dir=\"ltr\" role=\"presentation\">silindiri,</span></span><span id=\"page137R_mcid757\" class=\"markedContent\"><br role=\"presentation\" />V. <span dir=\"ltr\" role=\"presentation\">Baskı</span> <span dir=\"ltr\" role=\"presentation\">tasarımı</span></span></p>",

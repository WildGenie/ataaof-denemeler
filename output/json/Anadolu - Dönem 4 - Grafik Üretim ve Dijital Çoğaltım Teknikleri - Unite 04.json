        "D": "II",
        "E": "I",
        "DogruCevap": "A",
        "DersAd": "Grafik Üretim ve Dijital Çoğaltım Teknikleri",
        "Unite": 4,
        "Somestre": "4",
        "DogruCevapSirasi": null,
        "OlusturmaTarihi": "2025-11-30T20:16:59.948620",
        "GelYer": 0,
        "DersId": 0,
        "OBSDersId": 0,
        "CevapSira": null,
        "Aciklama": "<p><span id=\"page137R_mcid750\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\"> Ofset baskı sistemleri çeşitli temel bi</span></span><span id=\"page137R_mcid752\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">leşenlerin bir araya gelmesi ile çalışır. Bu bileşenler;</span></span></p> <p><span id=\"page137R_mcid753\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">•</span> <span dir=\"ltr\" role=\"presentation\">Mürekkepleme</span> <span dir=\"ltr\" role=\"presentation\">ünitesi,</span></span><span id=\"page137R_mcid754\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">•</span> <span dir=\"ltr\" role=\"presentation\">Nemlendirme</span> <span dir=\"ltr\" role=\"presentation\">ünitesi,</span></span><span id=\"page137R_mcid755\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">•</span> <span dir=\"ltr\" role=\"presentation\">Kalıp</span> <span dir=\"ltr\" role=\"presentation\">silindiri,</span></span><span id=\"page137R_mcid756\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">•</span> <span dir=\"ltr\" role=\"presentation\">Blanket</span> <span dir=\"ltr\" role=\"presentation\">(Kauçuk)</span> <span dir=\"ltr\" role=\"presentation\">silindiri,</span></span><span id=\"page137R_mcid757\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">•</span> <span dir=\"ltr\" role=\"presentation\">Baskı</span> <span dir=\"ltr\" role=\"presentation\">silindiri</span></span></p>"

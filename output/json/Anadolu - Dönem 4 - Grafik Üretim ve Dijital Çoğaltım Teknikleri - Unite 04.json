        "GelYer": 0,
        "DersId": 0,
        "OBSDersId": 0,
        "CevapSira": null,
        "Aciklama": "<span id=\"page123R_mcid608\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\"> Litogra</span></span><span id=\"page123R_mcid610\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">fi, baskı kalıpları üretmek için aradığı çözüm orta</span></span><span id=\"page123R_mcid612\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">ğını fotoğrafta buldu. Böylece litografi ve fotoğrafın </span></span><span id=\"page123R_mcid613\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">bir araya gelmesiyle</span></span><span id=\"page123R_mcid614\" class=\"markedContent\"> <span dir=\"ltr\" role=\"presentation\">fotolitografi</span></span><span id=\"page123R_mcid615\" class=\"markedContent\"> <span dir=\"ltr\" role=\"presentation\">doğdu. Fransız</span></span><span id=\"page123R_mcid616\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">bir bilim adamı olan Joseph Niepce, </span></span><span id=\"page123R_mcid617\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">1826’da dünyanın ilk fotoğrafını üret</span></span><span id=\"page123R_mcid619\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">ti.</span></span>"
    },

        "OBSDersId": 0,
        "CevapSira": null,
        "Aciklama": "<span id=\"page92R_mcid218\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\"> Hareketli tipo baskılar 11. yüzyılda </span></span><span id=\"page92R_mcid219\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Çin’de ve 15. yüzyılın başlarında Kore’de yapılmış</span></span><span id=\"page92R_mcid220\" class=\"markedContent\"><br role=\"presentation\" /><span dir=\"ltr\" role=\"presentation\">ancak binlerce karakterli Asya dillerine uygun ol</span></span><span id=\"page92R_mcid222\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">madığı için yaygınlaşmamıştır. </span></span>"
    },
    {
        "SoruID": 3764597,
        "SoruMetni": "<span id=\"page106R_mcid285\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Litografi kimin tarafından icat edilmiştir?</span></span>",
        "A": "<span id=\"page106R_mcid285\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Alo</span></span><span id=\"page106R_mcid287\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">is Senefelder</span></span>",

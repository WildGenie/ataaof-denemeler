        "GelYer": 0,
        "DersId": 0,
        "OBSDersId": 0,
        "CevapSira": null,
        "Aciklama": "<span id=\"page106R_mcid285\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Litografinin icadı, oyun ve tiyatro yazarı Alo</span></span><span id=\"page106R_mcid287\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">is Senefelder’in, yüzeyini mumla kapladığı cilalı </span></span><span id=\"page106R_mcid288\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">kireçtaşından bir tablet üzerine; mum, sabun ve </span></span><span id=\"page106R_mcid289\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">lamba isi ile hazırlanmış mürekkeple yazı yazdığı, </span></span><span id=\"page106R_mcid290\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">ardından kısa bir süre için bir asit çözeltisi uygula</span></span><span id=\"page106R_mcid292\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">dığı 1798 yılına kadar uzanmaktadır.</span></span>"
    },
    {
        "SoruID": 3764598,
        "SoruMetni": "<span id=\"page123R_mcid615\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">Fransız </span></span><span id=\"page123R_mcid616\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\"> bilim adamı olan Joseph Niepce <span id=\"page123R_mcid614\" class=\"markedContent\">fotolitografiyi tekniği ile ilk fotografı hangi tarihte</span></span></span><span id=\"page123R_mcid617\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\"> üret</span></span><span id=\"page123R_mcid619\" class=\"markedContent\"><span dir=\"ltr\" role=\"presentation\">ti?</span></span>",
